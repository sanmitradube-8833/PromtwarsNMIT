# PlateWise Environment Configuration Example
# Copy to .env for local development. In production, load secrets from Google Secret Manager.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=PlateWise
PORT=8000
HOST=0.0.0.0

# Google Cloud & Vertex AI Configuration
GCP_PROJECT_ID=platewise-prod
GCP_LOCATION=us-central1
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Firebase Configuration
FIREBASE_PROJECT_ID=platewise-prod
FIREBASE_APP_CHECK_SECRET=your_app_check_debug_token
FIREBASE_STORAGE_BUCKET=platewise-prod.appspot.com

# BigQuery Analytics Configuration
BIGQUERY_DATASET=platewise_analytics
ENABLE_REAL_BIGQUERY=false

# Security & Rate Limiting
JWT_SECRET_KEY=platewise_insecure_default_jwt_secret_change_in_prod_min_32_chars
RATE_LIMIT_PER_MINUTE=60
ENABLE_PII_REDACTION=true
ENABLE_PROMPT_INJECTION_DEFENSE=true

# Demo & Test Configuration
ENABLE_DEMO_SEED=true
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946
