rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for Auth, RBAC & App Check
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isNGO() {
      return hasRole('ngo') && request.auth.token.verified == true;
    }

    function isBusiness() {
      return hasRole('business');
    }

    // User & Dietary Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
      
      match /profiles/{profileId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /inventory/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Surplus Listings: Businesses and Households can create; NGOs and verified users can read
    match /surplus_listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isBusiness() || isOwner(request.resource.data.createdBy));
      allow update: if isAuthenticated() && (
        // Listing creator or admin can update status
        isOwner(resource.data.createdBy) ||
        isAdmin() ||
        // Verified NGO can claim an active listing atomically
        (isNGO() && resource.data.status == 'available' && request.resource.data.status == 'claimed' && request.resource.data.claimedBy == request.auth.uid)
      );
      allow delete: if isAdmin() || isOwner(resource.data.createdBy);
    }

    // Donation Claims
    match /claims/{claimId} {
      allow read: if isAuthenticated() && (
        resource.data.claimedBy == request.auth.uid ||
        resource.data.donorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isNGO() && request.resource.data.claimedBy == request.auth.uid;
      allow update: if isAdmin() || resource.data.donorId == request.auth.uid;
      allow delete: if false; // Immutable claims for audit integrity
    }

    // Agent Action Audit Logs: Write-only via backend service account; Read-only for Admin
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend service account writes directly
    }

    // Curated Food Safety KB & Taxonomy (Public Read)
    match /knowledge_base/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
